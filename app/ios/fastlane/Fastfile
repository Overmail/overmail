# Builds what deploy.yaml ships of the iOS app: one archive, uploaded to TestFlight and exported as
# the ad hoc IPA the release carries. Ad hoc installs on the devices registered with the team,
# which is every phone Xcode has run the app on.

default_platform(:ios)

platform :ios do
  desc "Upload the Release configuration to TestFlight and export an ad hoc IPA into build/"
  lane :release_ipa do
    # A throwaway keychain, so nothing waits for a password prompt on the runner.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
    )

    import_certificate(
      certificate_path: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PATH"),
      certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )

    # Xcode only registers the App ID once the Release scheme ran on a phone; this way the first
    # release does not depend on that. The api key above is also Spaceship's token.
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    unless Spaceship::ConnectAPI::BundleId.find(bundle_id)
      UI.message("Registering the App ID #{bundle_id}")
      Spaceship::ConnectAPI::BundleId.create(
        name: "Overmail",
        identifier: bundle_id,
        platform: "IOS",
      )
    end

    get_provisioning_profile(api_key: api_key)
    app_store_profile = lane_context[SharedValues::SIGH_NAME]

    archive_path = "build/Overmail.xcarchive"

    # The project signs automatically with a development certificate, which is what running it
    # from Xcode wants. Here the archive is signed by hand with the distribution certificate.
    build_app(
      project: "iosApp.xcodeproj",
      scheme: "Overmail",
      configuration: "Release",
      archive_path: archive_path,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { bundle_id => app_store_profile },
      },
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{app_store_profile}'",
        # Has to grow from build to build, for TestFlight too; the release tag says which one it is.
        "CURRENT_PROJECT_VERSION=#{ENV.fetch("BUILD_TIMESTAMP", "1")}",
      ].join(" "),
      output_directory: "build",
      output_name: "Overmail-AppStore.ipa",
    )

    # Internal testers get every build without a review, so there is nothing to wait for.
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/Overmail-AppStore.ipa",
      skip_waiting_for_build_processing: true,
    )

    # Renewed on every build: that is how a phone registered since the last release ends up in
    # the profile. Fetched only now, because build_app maps every profile fetched so far onto the
    # bundle id, over the export options, and the last one wins.
    get_provisioning_profile(api_key: api_key, adhoc: true, force: true)
    ad_hoc_profile = lane_context[SharedValues::SIGH_NAME]

    # The same archive again, re-signed for the registered devices.
    build_app(
      project: "iosApp.xcodeproj",
      scheme: "Overmail",
      skip_build_archive: true,
      archive_path: archive_path,
      export_method: "ad-hoc",
      export_options: {
        provisioningProfiles: { bundle_id => ad_hoc_profile },
      },
      output_directory: "build",
      output_name: "Overmail.ipa",
    )
  end
end
