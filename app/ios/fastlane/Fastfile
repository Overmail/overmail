# Builds the IPA that deploy.yaml attaches to a release. Ad hoc: it installs on the devices
# registered with the team, which is every phone Xcode has run the app on.

default_platform(:ios)

platform :ios do
  desc "Build a signed ad hoc IPA of the Release configuration into build/"
  lane :release_ipa do
    # A throwaway keychain, so nothing waits for a password prompt on the runner.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true,
    )

    import_certificate(
      certificate_path: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PATH"),
      certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )

    # Renewed on every build: that is how a phone registered since the last release ends up in
    # the profile.
    get_provisioning_profile(
      api_key: api_key,
      adhoc: true,
      force: true,
    )
    profile = lane_context[SharedValues::SIGH_NAME]

    # The project signs automatically with a development certificate, which is what running it
    # from Xcode wants. Here the build is signed by hand with the distribution certificate.
    build_app(
      project: "iosApp.xcodeproj",
      scheme: "Overmail",
      configuration: "Release",
      export_method: "ad-hoc",
      export_options: {
        provisioningProfiles: { "es.jvbabi.overmail" => profile },
      },
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile}'",
        # Has to grow from build to build; the release tag already says which one it is.
        "CURRENT_PROJECT_VERSION=#{ENV.fetch("BUILD_TIMESTAMP", "1")}",
      ].join(" "),
      output_directory: "build",
      output_name: "Overmail.ipa",
    )
  end
end
